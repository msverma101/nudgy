[Unit]
Description=Nudgy read-only WhatsApp bridge
PartOf=graphical-session.target
After=graphical-session.target network-online.target

[Service]
ExecStart=%h/.local/bin/nudgy whatsapp-bridge
Restart=on-failure
RestartSec=30
# Exit code 3 means the phone unlinked Nudgy; don't keep retrying then.
RestartPreventExitStatus=3

[Install]
WantedBy=graphical-session.target
